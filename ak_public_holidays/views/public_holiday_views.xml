<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_public_holiday_form" model="ir.ui.view">
        <field name="name">public.holiday.form</field>
        <field name="model">public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="year"/>
                        <field name="holiday_file" filename="holiday_filename"/>
                        <field name="holiday_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Holiday Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_public_holiday_list" model="ir.ui.view">
        <field name="name">public.holiday.list</field>
        <field name="model">public.holiday</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="year"/>
            </list>
        </field>
    </record>

    <record id="action_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holiday List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">public.holiday</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_public_holiday_list" name="Public Holiday List"
              parent="hr.menu_config_employee" action="action_public_holiday"/>
    </data>
</odoo>
