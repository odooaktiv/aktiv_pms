<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_tool_view_list" model="ir.ui.view">
        <field name="name">project.customer.tool.list</field>
        <field name="model">project.customer.tool</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="customer_tool_view_search" model="ir.ui.view">
        <field name="name">project.customer.tool.search</field>
        <field name="model">project.customer.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_customer_tool" model="ir.actions.act_window">
        <field name="name">Customer Tools</field>
        <field name="res_model">project.customer.tool</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_customer_tool" name="Customer Tools"
              parent="project.menu_project_config" action="action_customer_tool"
              sequence="26"
              groups="aktiv_pms.group_aktiv_project_manager,aktiv_pms.group_aktiv_project_functional"/>
</odoo>
