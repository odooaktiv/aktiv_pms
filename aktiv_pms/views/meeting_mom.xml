<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="meeting_mom_form_view" model="ir.ui.view">
            <field name="name">meeting.mom.form.view</field>
            <field name="model">meeting.mom</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="meeting_agenda_ids" widget="many2many_tags"/>
                                <field name="name" readonly="1"/>
                                <field name ="extra_participants"/>
                                <field name ="feedback"/>
                                <field name ="notes"/>
                            </group>
                            <group>
                                <field name="meeting_datetime" readonly="1"/>
                                <field name="meeting_id" readonly="1"/>
                                <field name="owner_ids" widget="many2many_tags" readonly="1"/>
                                <field name="participants_ids" widget="many2many_tags" readonly="1"/>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="meeting_mom_tree_view" model="ir.ui.view">
            <field name="name">meeting.mom.tree.view</field>
            <field name="model">meeting.mom</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="meeting_datetime"/>
                    <field name ="extra_participants"/>
                    <field name ="feedback"/>
                    <field name ="notes"/>
                </tree>
            </field>
        </record>

        <record id="action_meeting_mom" model="ir.actions.act_window">
            <field name="name">Meeting MOM</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">meeting.mom</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_meeting_mom" name="MOM" parent="project.menu_project_config" action="action_meeting_mom" sequence="10"/>
    </data>
</odoo>
