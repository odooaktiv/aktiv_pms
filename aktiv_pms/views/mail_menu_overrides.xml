<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- V19 mail module added Channels, Configuration, and Technical sub-menus under
         the Discuss app that did not exist in V17. Hide them to match V17 behaviour. -->
    <record id="mail.menu_channel" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="mail.menu_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="mail.discuss_technical" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Apps menu group restriction is handled by the migration script (_fix_apps_menu_groups)
         which sets group_system + group_erp_manager after all XML data is loaded. -->
</odoo>
