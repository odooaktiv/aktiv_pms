<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--     Add a menu named Basic Guidelines in Project Menu. This menu should be visisble to all the Users.
    Create a tree view which will have the following fields  1) Name - Char 2) Link - Text field -->

    <record id="form_basic_guidelines" model="ir.ui.view">
        <field name="name">form.basic.guidelines</field>
        <field name="model">pms.basic.guideline</field>
        <field name="arch" type="xml">
            <form string="guideline">
                <header>
                    <button string="Update Users" name="action_open_update_users_wizard"
                        type="object" invisible="not version"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" required="True"/>
                        <field name="link"/>
                        <field name="version"/>
                        <field name="remarks"/>
                        <field name="upload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tree_basic_guidelines" model="ir.ui.view">
        <field name="name">tree.basic.guidelines</field>
        <field name="model">pms.basic.guideline</field>
        <field name="arch" type="xml">
            <tree string="" editable="bottom">
                <field name="name"/>
                <field name="link"/>
                <field name="version"/>
                <field name="remarks"/>
                <field name="upload"/>
            </tree>
        </field>
    </record>

    <record id="action_basic_guidelines" model="ir.actions.act_window">
        <field name="name">Guidelines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pms.basic.guideline</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Basic Guidelines" id="menu_basic_guidelines" parent='project.menu_main_pm' action="action_basic_guidelines"/>

</odoo>
