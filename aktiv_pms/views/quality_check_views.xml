<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quality_check_point_tree_view" model="ir.ui.view">
            <field name="name">quality.check.points.tree.view</field>
            <field name="model">quality.check.points</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="is_required"/>  
                </tree>
            </field>
        </record>

        <record id="action_qulity_check_point" model="ir.actions.act_window">
            <field name="name">Module Quality Check</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">quality.check.points</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem id="menu_module_quality_check" name="Quality Check Points"
            parent="project.menu_project_config" action="action_qulity_check_point"
            groups="base.group_user"/>
    </data>
</odoo>
