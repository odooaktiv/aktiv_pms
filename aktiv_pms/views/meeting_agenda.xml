<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="meeting_agenda_form_view" model="ir.ui.view">
            <field name="name">meeting.agenda.form.view</field>
            <field name="model">meeting.agenda</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="meeting_agenda_tree_view" model="ir.ui.view">
            <field name="name">meeting.agenda.tree.view</field>
            <field name="model">meeting.agenda</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_meeting_agenda" model="ir.actions.act_window">
            <field name="name">Meeting Agenda</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">meeting.agenda</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
