<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="project_creation_wizard_wizard_form">
            <field name="name">project.creation.wizard</field>
            <field name="model">project.creation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="task" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="create_pms_project" type="object" string="Create" class="btn-primary"/>
                        <button special="cancel" string="Cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
