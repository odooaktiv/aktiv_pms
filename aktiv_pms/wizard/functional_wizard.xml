<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="account_analytic_line_wizard_form">
            <field name="name">account.analytic.line.wizard</field>
            <field name="model">account.analytic.line.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="approved_hours" widget="float_time"/>
                        <field name="text"/>
                    </group>
                    <footer>
                        <button name="submit_reason" type="object" string="Submit" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-info"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
