<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="view_quality_check_points_wizard" model="ir.ui.view">
            <field name="name">Quality Check Points View</field>
            <field name="model">quality.check.points.wizard</field>
            <field name="arch" type="xml">
                <form create="0">
                    <field name="quality_check_ids" widget="one2many_list">
                        <list editable="bottom" create="0" delete="0">
                            <field name="name" required="True" readonly="True"/>
                            <field name="is_required" readonly="True"/>
                            <field name="is_done"/>
                        </list>
                    </field>
                    <footer>
                        <button string="Confirm QC" type='object' name="action_confirm_qc"
                                class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
