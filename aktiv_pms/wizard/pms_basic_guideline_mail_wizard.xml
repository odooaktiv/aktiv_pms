<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- wizard to select user type and send mail with template id
    selected to that user on click of send button -->
    <record id="pms_basic_guideline_mail_wizard_form" model="ir.ui.view">
        <field name="name">pms.basic.guideline.mail.wizard.form</field>
        <field name="model">pms.basic.guideline.mail.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="user_type" required="True"/>
                    <field name="mail_template_id"/>
                </group>
                <footer>
                    <button string="Send" name="update_users_by_mail" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
