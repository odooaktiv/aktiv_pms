<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="view_meeting_reschedule_date_wizard" model="ir.ui.view">
            <field name="name">Meeting Reschedule</field>
            <field name="model">meeting.reschedule.wizard</field>
            <field name="arch" type="xml">
                <form>
                     <group>
                        <group>
                            <field name="meeting_datetime" required="1"/>
                            <field name="meeting_id" readonly="1" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="reschedule_datetime" string="Save" type="object" class="btn-info" required="1"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
