<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_review" model="ir.cron">
        <field name="name">Project: Send Customer Review</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model._send_customer_review_mail()</field>
        <field name="interval_type">days</field>
    </record>

    <record id="ir_cron_sync_timesheet_pmtool" model="ir.cron">
        <field name="name">Project: Sync Timesheet</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="state">code</field>
        <field name="code">model.auto_sync_timesheet_to_pm_tool()</field>
        <field name="interval_number">1</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 18:30:59')"/>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_revoke_group_access" model="ir.cron">
        <field name="name">Revoke Group Access</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model.revoke_group_access()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
