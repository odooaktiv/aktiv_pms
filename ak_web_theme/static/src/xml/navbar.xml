<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
	<t t-name="ak_web_theme.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
		<xpath expr="//DropdownItem[@t-if='currentApp']" position="replace"/>
		<xpath expr="//AppsMenu/t" position="replace">
			<t t-set-slot="toggler">
				<a class="o_menu_toggle" t-att-class="{'hasImage': currentApp &amp;&amp; currentApp.webIconData}"
				   accesskey="h" t-ref="menuApps">
					<svg class="o_menu_toggle_icon pe-none" width="20px" height="20px"
						 viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
						<g t-foreach="[0, 5, 10]" t-as="Y" t-att-id="'o_menu_toggle_row_'
						+ Y_index" fill="currentColor" t-key="'o_menu_toggle_row_' + Y_index">
							<rect t-foreach="[0, 5, 10]" t-as="X" width="3" height="3" t-att-x="X"
								  t-att-y="Y" t-key="'o_menu_toggle_cell_' + X_index"/>
						</g>
					</svg>
					<img
						t-if="currentApp &amp;&amp; currentApp.webIconData"
						t-attf-src="data:image/png;base64,{{currentApp.webIconData}}"
						class="o_menu_brand_icon d-none d-lg-inline position-absolute start-0 ps-1 ms-2"
						t-att-alt="currentApp.name"
						t-ref="appIcon"/>
					<span
						t-if="currentApp"
						t-esc="currentApp.name"
						class="o_menu_brand d-none d-md-flex ms-3 pe-0"/>
                </a>
			</t>
		</xpath>
		<xpath expr="//div[hasclass('o_menu_systray')]" position="replace">
			<div class="o_menu_systray d-flex flex-shrink-0 ms-auto" role="menu">
				<t t-foreach="systrayItems" t-as="item" t-key="item.key">
					<!-- This ensures the correct order of the systray items -->
					<div t-att-data-index="item.index"/>
					<ErrorHandler onError="error => this.handleItemError(error, item)">
						<t t-component="item.Component" t-props="item.props"/>
					</ErrorHandler>
				</t>
			</div>
		</xpath>
	</t>
</templates>
