<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ak_web_theme.NavBar"
       t-inherit="web.NavBar"
       t-inherit-mode="extension">

        <!-- Remove default app name dropdown item -->
        <xpath expr="//DropdownItem[@t-if='!env.isSmall and currentApp']" position="replace"/>

        <!-- Replace systray container to preserve v17 layout -->
        <xpath expr="//div[hasclass('o_menu_systray')]" position="replace">
            <div class="o_menu_systray d-flex flex-shrink-0 ms-auto" role="menu">
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <div t-att-data-index="item.index"/>
                    <ErrorHandler onError="error => this.handleItemError(error, item)">
                        <t t-component="item.Component" t-props="item.props"/>
                    </ErrorHandler>
                </t>
            </div>
        </xpath>

    </t>
    <!-- Extend AppsMenu toggle structure -->
    <t t-name="ak_web_theme.NavBar.AppsMenu"
       t-inherit="web.NavBar.AppsMenu"
       t-inherit-mode="extension">

        <!-- Replace default button with custom toggle anchor -->
        <xpath expr="//button" position="replace">

            <!-- Main apps toggle button -->
            <a class="o_menu_toggle o_navbar_apps_menu"
               t-att-class="{'o_menu_toggle_has_image': currentApp and currentApp.webIconData}"
               accesskey="h"
               href="#"
               t-ref="toggler"
               t-on-click.prevent="">

                <!-- 3x3 grid icon that morphs into back arrow via CSS -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="o_menu_toggle_icon"
                     width="20px"
                     height="20px"
                     viewBox="0 0 14 14">
                    <g t-foreach="[0, 5, 10]"
                       t-as="Y"
                       t-att-id="'o_menu_toggle_row_' + Y_index"
                       fill="currentColor"
                       t-key="'o_menu_toggle_row_' + Y_index">
                        <rect t-foreach="[0, 5, 10]"
                              t-as="X"
                              width="3"
                              height="3"
                              t-att-x="X"
                              t-att-y="Y"
                              t-key="'o_menu_toggle_cell_' + X_index"/>
                    </g>
                </svg>

                <!-- Show active app icon if available -->
                <img t-if="currentApp and currentApp.webIconData"
                     t-att-src="currentApp.webIconData"
                     class="o_menu_brand_icon"
                     t-att-alt="currentApp.name"
                     t-ref="appIcon"/>

                <!-- Show active app name -->
                <span t-if="currentApp"
                      t-esc="currentApp.name"
                      class="o_menu_brand"/>
            </a>
        </xpath>
    </t>
</templates>
