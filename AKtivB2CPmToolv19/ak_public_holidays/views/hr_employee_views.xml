<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_public_holiday" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.public.holiday</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_location_id']" position="after">
                <field name="holiday_list_id" options="{'no_create': True, 'no_create_edit':True}"/>
            </xpath>
        </field>
    </record>
</odoo>
