        <!--Customer Review template-->
        <record id="aktiv_review_project_request_email_template" model="mail.template">
            <field name="name">Project: Review Request Mail to Customer</field>
            <field name="model_id" ref="aktiv_pms.model_project_project"/>
            <field name="subject">{{ object.company_id.name }}: Satisfaction Survey
            </field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{
                (object.company_id.email or user.email) }}&gt;
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <table border="0" cellpadding="0" cellspacing="0" width="590"
                           style="width:100%; margin:0px auto;">
                        <tbody>
                            <tr>
                                <td valign="top" style="font-size: 13px;">
                                    <t t-if="object.partner_id.name">
                                        Hello <t t-out="object.partner_id.name or ''">
                                        Brandon Freeman</t>,
                                        <br/>
                                        <br/>
                                    </t>
                                    <t t-else="">
                                        Hello,
                                        <br/>
                                        <br/>
                                    </t>
                                    Please take a moment to review our services related
                                    to the project "<strong
                                        t-out="object.name or ''">Planning and
                                    budget</strong>"
                                    <t t-if="object.user_id.name">
                                        assigned to <strong
                                            t-out="object.user_id.name or ''">
                                        Mitchell Admin</strong>.
                                        <br/>
                                    </t>
                                    <t t-else="">
                                        .
                                        <br/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td valign="top" style="font-size: 13px;">
                                    We appreciate your feedback. It helps us to improve
                                    continuously.
                                    <!-- v17 referenced project-level rating_status / rating_status_period;
                                         in v19 those fields moved off project.project to project.task.type
                                         (stage). We now check across the project's stages: if any stage is
                                         in periodic mode, the project sends periodic rating emails, and we
                                         take that stage's rating_status_period as the displayed frequency. -->
                                    <t t-set="rating_periodic_stage" t-value="object.type_ids.filtered(lambda t: t.rating_status == 'periodic')[:1]"/>
                                    <t t-if="rating_periodic_stage">
                                        <br/>
                                        <span style="margin: 0px 0px 0px 0px; font-size: 12px; opacity: 0.5; color: #454748;">
                                            This customer survey is sent
                                            <b t-out="rating_periodic_stage.rating_status_period or ''">
                                                Weekly
                                            </b>
                                            as long as the project is in not done.
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
        <!--mail template-->
        <template id="mail_template_notification_inherit"
                  inherit_id="mail.mail_notification_light">
            <xpath expr="//table//tr//td//table//tr[1]" position="replace"/>
            <xpath expr="//table//tr//td//table//tbody//tr[2]" position="replace"/>
        </template>
        <template id="project_message_user_assigned_inherit"
                  inherit_id="project.project_message_user_assigned">
            <xpath expr="//span" position="replace">
                <span>
                    <t t-esc="object.description"/>
                </span>
                <a t-att-href="access_link" t-att-data-oe-model="object._name"
                   t-att-data-oe-id="object.id"
                   style="background-color:#000000; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px;">
                    View
                    <t t-esc="model_description or 'document'"/>
                </a>
            </xpath>
            <!-- <xpath expr="//p[1]//span[2]" position="after">
                <span>
                    <t t-esc="object.description"/>
                </span>
            </xpath> -->
        </template>
    </data>
</odoo>
