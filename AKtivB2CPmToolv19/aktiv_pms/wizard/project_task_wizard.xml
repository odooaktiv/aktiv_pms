<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="project_task_wizard_form">
            <field name="name">project.task.wizard</field>
            <field name="model">project.task.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="text"/>
                    </group>
                    <footer>
                        <button name="submit_reason" type="object" string="Submit" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-info"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
