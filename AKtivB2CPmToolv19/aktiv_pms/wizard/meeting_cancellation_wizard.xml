<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="view_meeting_cancellation_reason_wizard" model="ir.ui.view">
            <field name="name">Meeting Cancellation Wizard</field>
            <field name="model">meeting.cancellation.wizard</field>
            <field name="arch" type="xml">
                <form>
                     <group>
                        <group>
                            <field name="meeting_cancel_reason" required="1"/>
                            <field name="meeting_id" readonly="1" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="meeting_cancellation_reason" string="Save" type="object"  class="btn-info"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

