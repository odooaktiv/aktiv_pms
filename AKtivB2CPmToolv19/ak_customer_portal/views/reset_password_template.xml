<odoo>
    <template id="inherit_auth_signup_fields" inherit_id="auth_signup.fields">
        <xpath expr="//div[last()]" position="after">
            <div style="margin-top: -10px;">
                <span style="font-size: small;color: red;">
                    * Password length must be eight characters.</span>
            </div>
        </xpath>
    </template>
</odoo>
