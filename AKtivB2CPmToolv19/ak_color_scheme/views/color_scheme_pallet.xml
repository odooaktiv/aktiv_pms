<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_color_scheme_pallet_form" model="ir.ui.view">
        <field name="name">Color Scheme Pallet Form</field>
        <field name="model">colour.scheme.pallet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   class="oe_inline"
                                   placeholder="Color Pallet Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Color Scheme Mode">
                            <field name="company_id"
                                   invisible="1"/>
                            <field name="show_pallet_mode"
                                   widget="radio"/>
                        </group>
                        <group string="Header Colors">
                            <group>
                                <field name="header_color"
                                       widget="color"/>
                                <field name="header_color_font"
                                       widget="color"/>
                            </group>
                        </group>
                        <group string="Primary Colors">
                            <group>
                                <field name="primary_color"
                                       widget="color"/>
                                <field name="primary_color_font"
                                       widget="color"/>
                            </group>
                            <group>
                                <field name="darker_primary"/>
                            </group>
                        </group>
                        <group string="Secondary Colors">
                            <group>
                                <field name="secondary_color"
                                       widget="color"/>
                                <field name="secondary_color_font"
                                       widget="color"/>
                            </group>
                            <group>
                                <field name="darker_secondary"/>
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_color_scheme_pallet_tree" model="ir.ui.view">
        <field name="name">Color Scheme List</field>
        <field name="model">colour.scheme.pallet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="header_color"
                       widget="color"/>
                <field name="header_color_font"
                       widget="color"/>
                <field name="primary_color"
                       widget="color"/>
                <field name="primary_color_font"
                       widget="color"/>
                <field name="darker_primary"/>
                <field name="secondary_color"
                       widget="color"/>
                <field name="secondary_color_font"
                       widget="color"/>
                <field name="darker_secondary"/>
                <field name="show_pallet_mode"/>
            </list>
        </field>
    </record>

    <record id="action_color_scheme_pallet_configurator" model="ir.actions.act_window">
        <field name="name">Color Scheme Pallets</field>
        <field name="res_model">colour.scheme.pallet</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_color_scheme_pallet_parent"
              name="Color Pallet Scheme"
              action="ak_color_scheme.action_color_scheme_pallet_configurator"
              parent="base.menu_administration"
              sequence="30"/>
</odoo>
