<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="odoo_days_participant_tree_view" model="ir.ui.view">
        <field name="name">odoo.days.participant.tree.view</field>
        <field name="model">odoo.days.participant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="participant_type"/>
                <field name="objectives" widget="many2many_tags"/>
                <field name="answers"/>
            </list>
        </field>
    </record>
    <record id="odoo_days_participant_form_view" model="ir.ui.view">
        <field name="name">odoo.days.participant.form.view</field>
        <field name="model">odoo.days.participant</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="mobile"/>
                    </group>
                    <group>
                        <field name="participant_type"/>
                        <field name="objectives" widget="many2many_tags"/>
                        <field name="answers"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_odoo_days_participant" model="ir.actions.act_window">
        <field name="name">Odoo Days Participant</field>
        <field name="res_model">odoo.days.participant</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="action_odoo_days_participant" id="menu_odoo_days_participant" parent="menu_aktiv_odoo_days_root"/>
</odoo>