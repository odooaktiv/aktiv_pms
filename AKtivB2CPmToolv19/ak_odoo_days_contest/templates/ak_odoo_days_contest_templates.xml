<odoo>
    <template id="ak_odoo_days_contest" name="Aktiv Odoo Days Contest">
    <t t-call="website.layout">
        <t t-set="no_header" t-value="True"/>
        <t t-set="no_footer" t-value="True"/>
        <div id="wrap" class="oe_structure odoo_days_page">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6 col-12 aktiv_banner_wrapper">
                        <div class="row m-0 justify-content-center align-items-center h-100 aktiv_banner_div">
                            <img src="/ak_odoo_days_contest/static/src/image/akt_banner.png"/>
                        </div>
                    </div>
                    <div class="col-md-6 col-12 aktiv_form_wrapper">
                        <h1 class="pt16 text-center odoo_days_title">
                            <strong>Odoo Days Contest</strong>
                        </h1>
                        <form class="odoo_days_contest_form mx-auto py-3" style="max-width: 350px;" role="form" method="post">
                            <div class="input-group mb-3">
                                <input type="text" placeholder="Name" name="name" id="name" class="form-control" required="required" autofocus="autofocus" t-att-value="name or ''"/>
                            </div>
                            <div class="input-group mb-3">
                                <input type="email" placeholder="Email" name="email" id="email" class="form-control" required="required" autocapitalize="off" t-att-value="email or ''"/>
                            </div>
                            <div class="input-group mb-3">
                                <input type="text" pattern="\+?[0-9]{0,3} ?[0-9]{7,10}" placeholder="Mobile (+xx xxxxxxxxxx)" name="mobile" id="mobile" class="form-control" required="required" t-att-value="mobile or ''"/>
                            </div>
                            <div class="input-group mb-3">
                                <select name="participant_type" id="participant_type" class="form-control" required="required">
                                    <option value="">Join as</option>
                                        <option t-foreach="participant_type_options" t-as="type" t-attf-value="#{type.id}" t-att-selected="(participant_type and int(participant_type) == type.id) and 'selected'">
                                            <t t-esc="type.name"/>
                                        </option>
                                </select>
                            </div>
                            <div class="mb-3 has_hidden_field">
                                <label>What are your objectives to attend the Event?</label>
                                <input name="objectives" id="objectives" t-attf-class="hidden_field" required="required" t-attf-value="#{objective and json.stringify(objective) or ''}"/>
                            </div>
                            <div class="mb-3 objective_options_wrapper">
                                <t t-foreach="objective_options" t-as="obj_opt">
                                
                                <div class="objective_input">
                                        <input class="objectives_options" t-attf-id="objective_option_#{obj_opt.id}" type="checkbox" t-attf-value="#{obj_opt.id}" t-att-selected="(objective and obj_opt.id in [int(objt) for objt in objectives]) and 'checked'"/>
                                        <label class="objectives_options_label" t-attf-for="objective_option_#{obj_opt.id}"><t t-esc="obj_opt.name"/></label>
                                    </div>
                                </t>
                            </div>
                            <p class="alert alert-danger" t-if="error" role="alert">
                                <t t-esc="error"/>
                            </p>
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary btn-block odoo_days_submit_btn">Join Contest</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>

</odoo>