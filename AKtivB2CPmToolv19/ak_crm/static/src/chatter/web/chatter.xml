<?xml version="1.0" encoding="UTF-8"?>
<templates id="mail.template" xml:space="preserve">
    <t t-name="send_mail_messages" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="replace">
            <t t-if="state.thread.model === 'crm.lead' and state.leadType === 'lead'">
                <button class="btn btn-link" type="button" title="Send a mail"
                        data-hotkey="m"
                        t-on-click="openSendMail">Send Message</button>
            </t>
            <t t-else="">
                <button class="o-mail-Chatter-sendMessage btn text-nowrap me-1" t-att-class="{
                    'btn-primary': state.composerType !== 'note',
                    'btn-secondary': state.composerType === 'note',
                    'active': state.composerType === 'message',
                    'my-2': !props.compactHeight
                }" t-att-disabled="!state.thread.canPostMessage and props.threadId" data-hotkey="m" t-on-click="() => this.toggleComposer('message')">
                    Send message
                </button>
            </t>
        </xpath>
    </t>
</templates>
