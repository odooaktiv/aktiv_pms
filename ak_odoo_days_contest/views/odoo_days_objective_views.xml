<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="odoo_days_objective_list_view" model="ir.ui.view">
        <field name="name">odoo.days.objective.list.view</field>
        <field name="model">odoo.days.objective</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_odoo_days_objective" model="ir.actions.act_window">
        <field name="name">Odoo Days Objective</field>
        <field name="res_model">odoo.days.objective</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem action="action_odoo_days_objective" id="menu_odoo_days_objective" parent="menu_aktiv_odoo_days_root"/>
</odoo>
