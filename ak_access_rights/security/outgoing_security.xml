<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_odoo_outgoing" model="ir.rule">
        <field name="name">Users Show his Outgoing Mail Server</field>
        <field ref="base.model_ir_mail_server" name="model_id"/>
        <field name="domain_force">['|', ('smtp_user', '=', user.login), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
</odoo>
