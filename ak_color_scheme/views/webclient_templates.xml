<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="base_colour_template" name="Colour Scheme Template"
	          inherit_id="web.layout">
		<xpath expr="//head" position='inside'>
			<t t-if="not o" t-set="o" t-value="doc"/>
			<t t-if="not company">
				<t t-if="company_id">
					<t t-set="company" t-value="company_id"/>
				</t>
				<t t-elif="o and 'company_id' in o and o.company_id.sudo()">
					<t t-set="company" t-value="o.company_id.sudo()"/>
				</t>
				<t t-else="">
					<t t-set="company" t-value="res_company"/>
				</t>
			</t>
			<t t-if="isinstance(company, int)">
				<t t-set="company"
				   t-value="request.env['res.company'].sudo().browse(company)"/>
			</t>
			<t t-set="active_company" t-value="active_id or company"/>
			<t t-set="user" t-value="request.env.user"/>
			<t t-set="in_dark_mode"
			   t-value="request.httprequest.cookies.get('color_scheme') == 'dark'"/>
			<t t-if="not in_dark_mode">
				<t t-set="active_pallet"
				   t-value="(active_company.allow_user_scheme and user.colour_scheme_pallet_id) or active_company.colour_scheme_pallet_id"/>
				<t t-set="primary_color"
				   t-value="active_pallet.primary_color if active_pallet.darker_primary else active_pallet.primary_color_font"/>
				<t t-set="primary_color_font"
				   t-value="active_pallet.primary_color_font if active_pallet.darker_primary else active_pallet.primary_color"/>
				<t t-set="secondary_color"
				   t-value="active_pallet.secondary_color if active_pallet.darker_secondary else active_pallet.secondary_color_font"/>
				<t t-set="secondary_color_font"
				   t-value="active_pallet.secondary_color_font if active_pallet.darker_secondary else active_pallet.secondary_color"/>
			</t>
			<t t-else="">
				<t t-set="active_pallet"
				   t-value="(active_company.allow_user_scheme and user.dark_colour_scheme_pallet_id) or active_company.dark_colour_scheme_pallet_id"/>
				<t t-set="primary_color"
				   t-value="active_pallet.primary_color if not active_pallet.darker_primary else active_pallet.primary_color_font"/>
				<t t-set="primary_color_font"
				   t-value="active_pallet.primary_color_font if not active_pallet.darker_primary else active_pallet.primary_color"/>
				<t t-set="secondary_color"
				   t-value="active_pallet.secondary_color if not active_pallet.darker_secondary else active_pallet.secondary_color_font"/>
				<t t-set="secondary_color_font"
				   t-value="active_pallet.secondary_color_font if not active_pallet.darker_secondary else active_pallet.secondary_color"/>
			</t>
			<t t-if="active_pallet and not website_id">
				<t t-set="header_color" t-value="active_pallet.header_color"/>
				<t t-set="header_color_font" t-value="active_pallet.header_color_font"/>
				<t t-set="home_screen_background" t-value="active_company.home_screen_background"/>
				<t t-set="home_screen_background_style" t-value="active_company.home_screen_background_style"/>
		        <style>
			        <!-- Home menu background-->
			        <t t-if="home_screen_background and home_screen_background_style">
				        .o_home_menu_background .o_app_icon {
				        background: rgba(255, 255, 255, 0.05) !important;
				        border: 2px solid <t t-out="primary_color"/>
				        }
				        .o_home_menu_background:not(.o_home_menu_background_custom) .o_main_navbar {
		                    background-color: transparent !important;
		                    border-color: transparent !important;
		                }
				        .o_home_menu .o_app .o_caption {
		                    color: <t t-out="header_color_font"/> !important;
		                }
				        <t t-if="home_screen_background_style == 'gradiant'">
					        .o_home_menu_background {
			                    background: linear-gradient(135deg,<t t-out="header_color"/>,<t t-out="primary_color"/>) !important ;
			                }
				        </t>
				        <t t-if="home_screen_background_style == 'solid'">
					        .o_home_menu_background {
			                    background: <t t-out="header_color"/> !important ;
			                }
				        </t>
