	                .o_main_navbar > .o_menu_sections > .o-dropdown > button:hover,
	                .o_main_navbar > .o_menu_sections > .o-dropdown > .o-dropdown--menu > .dropdown-item:hover,
			        .o-mail-MessagingMenu > * > .o-mail-NotificationItem.o-important:hover,
			        .o-mail-ActivityGroup:hover,
