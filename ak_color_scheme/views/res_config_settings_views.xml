<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">Color Scheme</field>
		<field name="model">res.config.settings</field>
		<field name="priority" eval="80"/>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app name="ak_color_scheme" data-string="Color Scheme"
				     string="Color Scheme" data-key="ak_color_scheme">
					<block title="User Color Scheme">
						<block>
							<setting string="Allow User Color Scheme"
							         help="Allow user to select color scheme.">
								<field name="allow_user_scheme"/>
							</setting>
							<setting string="Apply Home-screen Background" help="Apply home-screen background." invisible="is_web_enterprise == False">
								<field name="home_screen_background" />
								<field name="home_screen_background_style" invisible="home_screen_background == False" required="home_screen_background == True"/>
								<field name="is_web_enterprise" invisible="1"/>
							</setting>
							<setting>
								<button name="reset_color_scheme_pallet" type="object" invisible="not colour_scheme_pallet_id and not dark_colour_scheme_pallet_id and not allow_user_scheme"
								        string="Reset Color Scheme"
								        class="btn-danger"/>
							</setting>
						</block>
					</block>
					<block title="Base Mode Colors" name="base_mode_colors">
						<block>
							<setting id="colour_scheme_pallet_id">
								<div class="content-group">
									<div class="mt16">
										<label for="colour_scheme_pallet_id"
										       string="Active Color Pallet"
										       class="o_light_label mr8"/>
										<field name="colour_scheme_pallet_id"
										       class="oe_inline"
										       domain="[('company_id', 'in', [company_id, False]), ('show_pallet_mode', '!=', 'dark')]"
										       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
									</div>
								</div>
								<div class="content-group">
									<div class="mt8">
										<button
											name="create_color_scheme_pallet"
											icon="oi-arrow-right" type="object"
											string="Create Color Scheme"
											class="btn-link"/>
										<button
											name="update_color_scheme_pallet"
											icon="oi-arrow-right" type="object"
											string="Update Color Scheme"
											class="btn-link"
											invisible="colour_scheme_pallet_id == False"/>
									</div>
								</div>
							</setting>
						</block>
						<block>
							<setting>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="header_color"/>
									</span>
									<field name="header_color"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="header_color_font"/>
									</span>
									<field name="header_color_font"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
						</block>
						<block>
							<setting>
								<div class="w-50 row mt-1">
									<span class="d-block w-75 py-2">
										<label for="primary_color"/>
									</span>
									<field name="primary_color"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row mt-1">
									<span class="d-block w-75 py-2">
										<label for="primary_color_font"/>
									</span>
									<field name="primary_color_font"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
							<setting
								string="Is primary color darker than primary font color?"
								help="Is primary color darker than primary font color?">
								<field name="darker_primary"/>
							</setting>
							<setting id="base_mode_colors" string="">
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="secondary_color"/>
									</span>
									<field name="secondary_color"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="secondary_color_font"/>
									</span>
									<field name="secondary_color_font"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
							<setting
								string="Is secondary color darker than secondary font color?"
								help="Is secondary color darker than secondary font color?">
								<field name="darker_secondary"/>
							</setting>
						</block>
					</block>
					<block title="Dark Mode Colors" name="dark_mode_colors" invisible="is_web_enterprise == False">
						<block>
							<setting id="dark_colour_scheme_pallet_id">
								<div class="content-group">
									<div class="mt16">
										<label for="dark_colour_scheme_pallet_id"
										       string="Active Color Pallet"
										       class="o_light_label mr8"/>
										<field name="dark_colour_scheme_pallet_id"
										       class="oe_inline"
										       domain="[('company_id', 'in', [company_id, False]), ('show_pallet_mode', '!=', 'light')]"
										       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
									</div>
								</div>
								<div class="content-group">
									<div class="mt8">
										<button
											name="create_color_scheme_pallet"
											icon="oi-arrow-right" type="object"
											string="Create Color Scheme"
											class="btn-link"
											context="{'dark_color_pallet': True}"/>
										<button
											name="update_color_scheme_pallet"
											icon="oi-arrow-right" type="object"
											string="Update Color Scheme"
											class="btn-link"
											invisible="dark_colour_scheme_pallet_id == False"
											context="{'dark_color_pallet': True}"/>
									</div>
								</div>
							</setting>
						</block>
						<block>
							<setting>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="header_color_dark"/>
									</span>
									<field name="header_color_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="header_color_font_dark"/>
									</span>
									<field name="header_color_font_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
						</block>
						<block>
							<setting>
								<div class="w-50 row mt-1">
									<span class="d-block w-75 py-2">
										<label for="primary_color_dark"/>
									</span>
									<field name="primary_color_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row mt-1">
									<span class="d-block w-75 py-2">
										<label for="primary_color_font_dark"/>
									</span>
									<field name="primary_color_font_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
							<setting
								string="Is primary color(dark) darker than primary font color(dark)?"
								help="Is primary color(dark) darker than primary font color(dark)?">
								<field name="darker_primary_dark"/>
							</setting>
							<setting id="dark_mode_colors">
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="secondary_color_dark"/>
									</span>
									<field name="secondary_color_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
								<div class="w-50 row">
									<span class="d-block w-75 py-2">
										<label for="secondary_color_font_dark"/>
									</span>
									<field name="secondary_color_font_dark"
									       class="d-block w-25 p-0 m-0" widget="color"/>
								</div>
							</setting>
							<setting
								string="Is secondary color(dark) darker than secondary font color(dark)?"
								help="Is secondary color(dark) darker than secondary font color(dark)?">
								<field name="darker_secondary_dark"/>
							</setting>
						</block>
					</block>
				</app>
			</xpath>
		</field>
	</record>

</odoo>
