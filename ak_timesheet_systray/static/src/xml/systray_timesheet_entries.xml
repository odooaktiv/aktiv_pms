<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="ak_timesheet_systray.FetchTimesheetEntries">
        <Dropdown position="'bottom-end'">
            <button class="btn o-timesheet-systray-toggler position-relative border-0 bg-transparent"
                    t-on-click="() => this.handleTimesheetSystrayClick()">
                <img src="/ak_timesheet_systray/static/description/img.png" style="width:20px;height:20px;" role="img"
                     class="fa fa-pie-chart" alt="Custom Icon" aria-label="Timesheet Entries"/>
                <span t-if="counter" class="o-mail-MessagingMenu-counter badge rounded-pill">
                    <t t-esc="counter"/>
                </span>
            </button>
            <t t-set-slot="content">
            <div t-if="state.syncing" class="d-flex align-items-center justify-content-center gap-2 p-3"
                 style="width: 400px; color: #35b164; font-weight: bold;">
                <span class="spinner-border spinner-border-sm" role="status"/>
                <span>Syncing timesheet entries...</span>
            </div>
            <div t-if="!state.syncing and state.timesheetEntries and state.timesheetEntries.length === 0"
                 class="dropdown-item"
                 style="background-color: #f8f9fa; padding: 20px; border-radius: 10px; border: 1px solid #ddd;">
                <span style="height: 15px;width: 400px; display: flex; align-items: center; justify-content: center;
                                 font-size: 18px; color: gray; font-weight: bold; text-align: center;">
                    <t t-if="state.sync">
                        Timesheet synced successfully
                    </t>
                    <t t-else="">
                        No unsynced timesheet entries found</t>
                </span>
            </div>
            <div t-if="state.timesheetEntries and state.timesheetEntries.length > 0">
                <div class="timesheet-header d-flex flex-wrap align-items-center justify-content-between">
                    <div class="d-flex flex-wrap">
                        <button class="tab-button" t-att-class="{'active': state.activeTab === 'all'}" type="button"
                                t-on-click="() => { this.fetchTimesheetEntries(); state.activeTab = 'all'; }"
                                role="tab">
                            All
                        </button>
                        <button class="tab-button" t-att-class="{'active': state.activeTab === 'project_group'}"
                                type="button"
                                t-on-click="() => { this.fetchTimesheetEntries(); state.activeTab = 'project_group'; }"
                                role="tab">
                            Project
                        </button>
                        <button class="tab-button" t-att-class="{'active': state.activeTab === 'task_group'}"
                                type="button"
                                t-on-click="() => { this.fetchTimesheetEntries(); state.activeTab = 'task_group'; }"
                                role="tab">
                            Task
                        </button>

                        <!--                    <button class="tab-button" t-att-class="{'active': state.activeTab === 'date_range'}" type="button"-->
                        <!--                            t-on-click="() => state.activeTab = 'date_range'" role="tab">-->
                        <!--                        Date-->
                        <!--                    </button>-->

                        <button class="tab-button"
                                t-att-class="{'active': state.activeTab === 'date_range'}"
                                type="button"
                                t-on-click="() => { this.fetchTimesheetEntries(); state.activeTab = 'date_range'; }"
                                role="tab">
                            Date
                        </button>
                    </div>
                    <t t-if="state.timesheetEntries.length > 0 ">
                        <button class="sync-button" type="button" t-on-click="() => this.syncTimesheetEntries()">
                            Sync
                        </button>
                    </t>
                </div>

                <div style="width: 500px; padding: 0px; margin: 0px; background-color: white;">
                    <li t-if="!state.timesheetEntries || state.timesheetEntries.length === 0"
                        class="dropdown-item"
                        style="background-color: #f8f9fa; padding: 20px; border-radius: 10px; border: 1px solid #ddd;">
                        <span style="height: 100px; display: flex; align-items: center; justify-content: center;
                                 font-size: 18px; color: red; font-weight: bold; text-align: center;">
                            No unsynced timesheet entries found
                        </span>
                    </li>

                    <t t-if="state.timesheetEntries and state.timesheetEntries.length > 0 and state.activeTab === 'all'">
                        <div class="timesheet-entries-list">
                            <t t-foreach="state.timesheetEntries" t-as="entry" t-key="entry.id">
                                <div class="timesheet-entry card mb-2 shadow-sm">
                                    <div class="card-body p-3">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0 me-3 d-flex align-items-center">
                                                <div class="rounded-circle bg-primary p-2 d-flex justify-content-center align-items-center"
                                                     style="width: 50px; height: 50px;">
                                                    <i class="fa fa-clock-o text-white fs-4"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <h6 class="text-primary text-truncate mb-0 project-name"
                                                        t-att-title="entry.project_id[1]" t-esc="entry.project_id[1]"/>
                                                    <span class="badge bg-secondary" t-esc="entry.formattedDate"/>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mb-2 task-project-name">
                                                    <div class="project-name">
                                                        <span class="fw-bold" style="padding-right:5px">Task:</span>
                                                        <span class="text-truncate "
                                                              t-att-title="entry.task_id[1]"
                                                              t-esc="entry.task_id[1]"/>
                                                    </div>
                                                    <div>
                                                       <span class="badge bg-success"
                                                          t-esc="formatFloatTime(entry.unit_amount)"/>
                                                    </div>
                                                </div>
                                                <div class="small timesheet-description">
                                                    <span t-esc="entry.name" t-att-data-tooltip="entry.name"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="state.projectList and state.projectList.length > 0 and state.activeTab === 'project_group'">
                        <div class="project-list border border-primary rounded">
                            <t t-foreach="state.projectList" t-as="project" t-key="project.id">
                                <div class="dropdown-item timesheet-entry d-flex align-items-center p-3 border-bottom hover-bg-light">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="rounded-circle bg-primary p-2 d-flex justify-content-center align-items-center"
                                             style="width: 50px; height: 50px;">
                                            <i class="fa fa-briefcase text-white fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-2 text-primary text-truncate project-group-project-name"
                                            t-att-title="project.name"
                                            t-esc="project.name"/>
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span class="me-2">
                                                <i class="fa fa-exclamation-circle text-warning me-1"></i>
                                                <t t-esc="project.taskCount"/>
                                                <t t-if="project.taskCount !== 1">Tasks</t>
                                                <t t-else="">Task</t>
                                            </span>
                                            <span>
                                                <i class="fa fa-clock-o me-1"></i>
                                                <t t-esc="project.entryCount"/>
                                                Timesheet
                                                <t t-if="project.entryCount !== 1">Entries</t>
                                                <t t-else="">Entry</t>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>


                    <t t-if="state.projectList and state.activeTab === 'task_group'">
                        <t t-foreach="state.projectList" t-as="project" t-key="project.id">
                            <div class="project-group mb-3">
                                <h6 class="project-title px-3 py-2 bg-primary text-white rounded-top mb-0 task-project-name"
                                    t-esc="project.name"/>
                                <div class="task-list border border-primary border-top-0 rounded-bottom">
                                    <t t-foreach="project.tasks" t-as="task" t-key="task.id">
                                        <div class="dropdown-item timesheet-entry d-flex align-items-center p-2 border-bottom hover-bg-light">
                                            <div class="flex-shrink-0 me-3">
                                                <div class="rounded-circle bg-primary p-2 d-flex justify-content-center align-items-center"
                                                     style="width: 40px; height: 40px;">
                                                    <i class="fa fa-tasks text-white"></i>
                                                </div>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 text-truncate text-primary task-group-task-name"
                                                    t-esc="task.name"/>
                                                <div class="small text-muted">
                                                    <span t-esc="task.count"/>
                                                    Timesheet
                                                    <t t-if="task.count !== 1">Entries</t>
                                                    <t t-else="">Entry</t>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- List of Entries -->
<!--                                        <ul class="list-group mt-2 mb-2">-->
<!--                                            <t t-foreach="task.entries" t-as="entry" t-key="entry.id">-->
<!--                                                <li class="list-group-item d-flex justify-content-between align-items-center dropdown-item timesheet-entry d-flex">-->
<!--                                                    <div class="task-group-task-name">-->
<!--                                                        <div class="text-muted small" t-esc="formatDate(entry.date)"/>-->
<!--                                                        <div class="fw-bold">-->
<!--                                                            *-->
<!--                                                            <span t-esc="entry.name"/>-->
<!--                                                        </div>-->
<!--                                                    </div>-->
<!--                                                    <span class="badge bg-success"-->
<!--                                                          t-esc="formatFloatTime(entry.unit_amount)"/>-->
<!--                                                </li>-->
<!--                                            </t>-->
<!--                                        </ul>-->
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>


                    <t t-if="state.dateGroupedEntries and state.activeTab === 'date_range'">
                        <div class="date-range-list border border-primary rounded">
                            <t t-foreach="state.dateGroupedEntries" t-as="date_range" t-key="date_range.date">
                                <div class="dropdown-item timesheet-entry d-flex align-items-center p-3 border-bottom hover-bg-light">
                                    <div class="flex-shrink-0 me-3">
                                        <div class="rounded-circle bg-primary p-2 d-flex justify-content-center align-items-center"
                                             style="width: 50px; height: 50px;">
                                            <i class="fa fa-calendar text-white fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-2 text-primary" t-esc="date_range.date"/>
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span>
                                                <i class="fa fa-clock-o me-1"></i>
                                                <t t-esc="date_range.entryCount"/>
                                                Timesheet Entries
                                            </span>
                                            <span>
                                                <i class="fa fa-briefcase me-1"></i>
                                                <t t-esc="date_range.projectCount"/>
                                                Projects
                                            </span>
                                            <span>
                                                <i class="fa fa-tasks me-1"></i>
                                                <t t-esc="date_range.taskCount"/>
                                                Tasks
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
            </t>
        </Dropdown>
    </t>
</templates>