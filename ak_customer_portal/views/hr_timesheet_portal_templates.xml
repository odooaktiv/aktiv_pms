<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit portal timesheet template -->
    <template id="customer_portal_timesheets_inherit" inherit_id="hr_timesheet.portal_my_timesheets">

        <!-- Removed employee & project from portal timesheet list view -->
        <xpath expr="//thead/tr" position="replace">
            <th t-if="not groupby == 'date'">Date</th>
            <th t-if="not groupby == 'task'">Task</th>
            <th>Description</th>
            <th t-if="is_uom_day" class="text-right">Days Spent</th>
            <th t-else="" class="text-right">Hours Spent</th>
        </xpath>
       <!--  <xpath expr="//thead/tr" position="attributes">
            <attribute name="t-attf-class">#{'d-none'}</attribute>
        </xpath> -->
        <xpath expr="//tbody[2]" position="replace">
            <tbody style="font-size: 0.8rem">
                <t t-foreach="timesheets" t-as="timesheet">
                    <tr>
                        <td t-if="not groupby == 'date'"><span t-field="timesheet.date" t-options='{"widget": "date"}'/></td>
                        <td t-if="not groupby == 'task'"><span t-field="timesheet.task_id" t-att-title="timesheet.task_id.display_name"/></td>
                        <td><span t-esc="timesheet.name" t-att-title="timesheet.name"/></td>
                        <!-- customization starts: display approved hours instead invested hours -->
                        <td class="text-right">
                            <span t-if="is_uom_day" t-esc="timesheet._get_timesheet_time_day()" t-options='{"widget": "timesheet_uom"}'/>
                            <span t-else="" t-field="timesheet.approved_hours" t-options='{"widget": "float_time"}'/>
                        </td>
                        <!-- customization ends -->
                    </tr>
                </t>
            </tbody>
        </xpath>
        <!--  -->

    </template>

</odoo>
