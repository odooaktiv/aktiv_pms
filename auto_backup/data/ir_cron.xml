<?xml version="1.0" encoding="utf-8" ?>
<!--
    ir.cron field changes introduced in Odoo 18.0 (affects 19.0 too):
      - 'numbercall' field REMOVED (cron now runs indefinitely by default)
      - 'doall' field REMOVED
    The 'nextcall' eval expression uses DateTime (capital D) — the alias
    available in Odoo XML eval context since v16. 'datetime' (lowercase)
    still works in v19 but DateTime is the idiomatic form.
-->
<odoo noupdate="1">
    <record id="ir_cron_backup_scheduler_0" model="ir.cron">
        <field name="name">Backup Scheduler</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"
        />
        <field name="model_id" ref="model_db_backup" />
        <field name="state">code</field>
        <field name="code">model.action_backup_all()</field>
    </record>
</odoo>
