<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="contest_certificate_report_view">
		<t t-set="base_url" t-value="request.env['ir.config_parameter'].get_param('web.base.url')"/>
		<t t-call="web.basic_layout">
			<div class="page">
				<t t-foreach="docs" t-as="o">
					<div class="odoo_days_certificate" t-attf-style="background-image: url('#{base_url}/ak_survey/static/image/odoo_days_certificate.jpg'); background-position: center; background-repeat: no-repeat; background-size: 100% 100%; margin:auto;">
						<div class="certificate_wrapper">
							<div class="certificate_logo">
								<img t-attf-src="#{base_url}/ak_survey/static/description/icon.png" class="certificate_logo_img"/>
							</div>
							<div class="certificate_first_header">
								CERTIFICATE
							</div>
							<div class="certificate_second_header">
								OF ACHIEVEMENT
							</div>
							<div class="participant_name">
								<t t-out="o.participant_id.name"/>
							</div>
							<div class="participant_underline">
								<img t-attf-src="#{base_url}/ak_survey/static/image/certificate_border.png" class="participant_underline_img"/>
							</div>
							<p class="certificate_content_1">
								In recognition of your outstanding performance and dedication in the Odoo Days Contest Hosted by Aktiv Software,
								we take immense pleasure in presenting you with this Certificate of Achievement. Your remarkable achievements in
								the contest have demonstrated your expertise in Odoo.
							</p>
							<p class="certificate_content_2">
								In addition to this certificate of achievement, you are also entitled to recieve amazing gifts.
							</p>
							<div style="padding-top: 50px;">
								<div style="padding: 50px; width: 50%; float: left;">
									<div class="signature_image_block">
										<img t-attf-src="#{base_url}/ak_survey/static/image/j_shah_digital_signature.png" class="signature_image"/>
									</div>
									<div class="signature_underline"/>
									<div class="signature_text">
										Signature
									</div>
								</div>
								<div style="padding: 50px; width: 50%; float: right;">
									<div class="date_block">
										<t t-out="datetime.datetime.now().date().strftime('%d-%m-%Y')"/>
									</div>
									<div class="date_underline"/>
									<div class="date_text">
										Date
									</div>
								</div>
							</div>
						</div>
					</div>
				</t>
			</div>
		</t>
	</template>
</odoo>