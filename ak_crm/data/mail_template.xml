<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lead assigned mail -->
    <record id="ak_crm_lead_assigned_template" model="mail.template">
        <field name="name">Lead / Opportunity Assignation</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">{{ object.id }} - Lead Assigned</field>
        <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
        <field name="lang">{{ object.user_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div>
                <table border="0" cellpadding="0" cellspacing="0" width="590"
                       style="width:100%; margin:0px auto;">
                    <tbody>
                        <!-- HEADER START -->
                        <tr>
                            <td align="center" style="min-width: 590px;">
                                <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                    <tr><td valign="middle">
                                        <img t-attf-src="/logo.png?company={{ object.company_id.id }}" style="padding: 0px; margin: 0px; height: auto; width: 80px;" t-att-alt="object.company_id.name"/>
                                    </td><td valign="middle" align="right">
                                         <span style="font-size: 20px; font-weight: bold;">
                                            <t t-out="object.company_id.name or ''"></t>
                                        </span>
                                    </td></tr>
                                    <tr><td colspan="2" style="text-align:center;">
                                      <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                    </td></tr>
                                </table>
                            </td>
                        </tr>
                        <!-- HEADER END -->
                        <tr>
                            <td valign="top" align="center" style="font-size: 13px;">
                                <t t-if="object.user_id.name">
                                    Hello <t t-out="object.user_id.name"></t>,
                                    <br/>
                                    <br/>
                                </t>
                                <t t-else="">
                                    Hello,
                                    <br/>
                                    <br/>
                                </t>
                                A new lead <t t-if="object.id"><t t-out="object.id or ''" /> - <t t-out="object.name or ''" /></t> has been assigned to you.
                                <br/>
                                <t t-if="object.id">
                                    <p style="padding-top: 24px; padding-bottom: 16px;">
                                        <a t-att-href="object._notify_get_action_link('view')" style="background-color:#875A7B; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px;">View Lead/Opportunity</a>
                                    </p>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/><br/>
                Thank You,
                <t t-if="user.signature">
                    <br />
                    <t t-out="user.signature or ''"/>
                </t>
            </div>
        </field>
    </record>

