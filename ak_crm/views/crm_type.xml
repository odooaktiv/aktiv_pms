<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="crm_type_form_view" model="ir.ui.view">
            <field name="name">crm.type.form.view</field>
            <field name="model">crm.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="crm_type_tree_view" model="ir.ui.view">
            <field name="name">crm.type.tree.view</field>
            <field name="model">crm.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" required="1"/>
                </list>
            </field>
        </record>

        <record id="action_crm_type" model="ir.actions.act_window">
            <field name="name">Crm Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">crm.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
