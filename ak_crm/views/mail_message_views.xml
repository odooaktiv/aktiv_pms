<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ak_crm_inherit_mail_message_view_form" model="ir.ui.view">
        <field name="name">aktiv.crm.inherit.mail.message.view.form</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subtype_id']" position="after">
                <field name="crm_type" invisible="0"/>
                <field name="mail_to" invisible="0"/>
            </xpath>
        </field>
    </record>
</odoo>
