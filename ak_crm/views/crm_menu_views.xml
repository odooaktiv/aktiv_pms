<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create menu for Mediums & Sources -->
    <menuitem
        id="crm_medium_config"
        name="Mediums"
        parent="crm.crm_menu_config"
        sequence="21"
        action="utm.utm_medium_action"
        groups="crm.group_use_lead"
        />
    <menuitem
        id="crm_source_config"
        name="Sources"
        parent="crm.crm_menu_config"
        sequence="22"
        action="utm.utm_source_action"
        groups="crm.group_use_lead"
        />
    <menuitem id="crm.crm_menu_leads"
              name="Leads"
              parent="crm.crm_menu_root"
              groups="crm.group_use_lead"
              sequence="5"/>
    
    <!--    email lead action-->
    <record id="view_crm_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.kanban</field>
        <field name="model">crm.lead</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_mobile" archivable="false" js_class="crm_kanban" sample="1">
                <field name="stage_id" />
                <field name="name"/>
                <field name="contact_name"/>
                <field name="priority"/>
                <field name="tag_ids"/>
                <field name="user_id"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div>
                                <strong class="o_kanban_record_title">
                                    <span>
                                        <field name="name"/>
                                    </span>
                                </strong>
                            </div>
                            <div>
                                <span class="o_kanban_record_subtitle">
                                    <field name="contact_name"/>
                                </span>
                            </div>
                            <div>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority"/>
                                    <div class="o_kanban_inline_block">
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="crm_lead_email_leads" model="ir.actions.act_window">
        <field name="name">Email Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,tree,graph,pivot,calendar,form,activity</field>
        <field name="view_id" ref="ak_crm.view_crm_lead_kanban"/>
        <field name="domain">[('stage_id.stage_id_type_key', 'ilike', 'lead'), ('type', '=', 'lead'), ('type', '!=', False), '|', ('fetched_from', '!=', ''), ('lead_type', 'in', ('b2b_inbound', 'b2c_inbound'))]
        </field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="context">{
            'default_type':'lead',
            'search_default_type': 'lead',
            'search_default_to_process':1,
            'email_leads':True,
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Email Lead
            </p>
            <p>
                Leads are the qualification step before the creation of an opportunity.
            </p>
        </field>
    </record>
    <record id="crm_case_tree_view_leads" model="ir.ui.view">
        <field name="name">crm.lead.tree.lead</field>
        <field name="model">crm.lead</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <tree string="Leads" sample="1" multi_edit="1">
                <field name="date_deadline" invisible="1"/>
                <field name="create_date" optional="hide"/>
                <field name="name" string="Lead" readonly="1"/>
                <field name="contact_name" optional="hide"/>
                <field name="partner_name" optional="hide"/>
                <field name="email_from" optional="show"/>
                <field name="phone" optional="show" class="o_force_ltr"/>
                <field name="company_id" optional="show"/>
                <field name="city" optional="show"/>
                <field name="state_id" optional="hide"/>
                <field name="country_id" optional="show" options="{'no_open': True, 'no_create': True}"/>
                <field name="partner_id" invisible="1"/>
                <!-- Explicit domain due to multi edit -> real company domain would be complicated -->
                <field name="user_id" optional="show" widget="many2one_avatar_user"
                       domain="[('share', '=', False)]"/>
                <!-- <field name="team_id" optional="show"/> -->
                <field name="active" invisible="1"/>
                <field name="campaign_id" optional="hide"/>
                <field name="referred" invisible="1"/>
                <field name="medium_id" optional="hide"/>
                <field name="source_id" optional="hide"/>
                <field name="probability" string="Probability (%)" optional="hide"/>
                <field name="message_needaction" invisible="1"/>
                <field name="tag_ids" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="priority" optional="hide"/>
            </tree>
        </field>
    </record>

    <menuitem id="crm_menu_email_leads"
              name="Email Leads"
              parent="crm.crm_menu_leads"
              action="crm_lead_email_leads"
              groups="crm.group_use_lead"
              sequence="3"/>

    <!--    leads menu-->
    <menuitem
            id="crm_menu_all_leads"
            name="All Leads"
            parent="crm.crm_menu_leads"
            action="crm.crm_lead_all_leads"
            groups="crm.group_use_lead"
            sequence="5"/>

    <menuitem
            id="crm.crm_menu_root"
            name="CRM"
            action="crm.crm_lead_action_pipeline"
            web_icon="crm,static/description/icon.png"
            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
            sequence="25"/>

    <record model="ir.actions.act_window" id="crm.crm_lead_all_leads">
        <field name="domain">['|',('type','=','lead'), ('type','=',False)]</field>
    </record>

    <!-- Outbond Menu Action -->
    <record model="ir.actions.act_window" id="crm_lead_outbound_leads">
        <field name="name">Outbound Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,tree,graph,pivot,calendar,form,activity</field>
        <field name="domain">[('stage_id.stage_id_type_key', 'ilike', 'outbound_lead'), ('type', '=', 'lead'), ('type', '!=', False), ('lead_type', 'in', ('b2b_outbound', 'b2c_outbound')), ('fetched_from', '=', False)]
        </field>
        <field name="search_view_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="context">{
            'default_type':'lead',
            'search_default_type': 'lead',
            'search_default_to_process':1,
            'outbound_leads':True,
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Outbound Lead
            </p>
        </field>
    </record>

    <!-- Outbond Menu in CRM -->
    <menuitem
            id="crm_menu_outbound_leads"
            name="Outbound Leads"
            parent="crm.crm_menu_leads"
            action="crm_lead_outbound_leads"
            groups="crm.group_use_lead"
            sequence="4"/>

</odoo>
