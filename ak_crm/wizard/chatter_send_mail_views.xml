<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Send mail form view -->
    <record id="chatter_send_mail_wizard_form" model="ir.ui.view">
        <field name="name">chatter.send.mail.form</field>
        <field name="model">chatter.send.mail</field>
        <field name="arch" type="xml">
            <form string="Send mail">
                <group>
                    <field name="email_to" widget="email"/>
                    <field name="email_cc" widget="email"/>
                    <field name="subject" placeholder="Subject..." required="True"/>
                </group>
                <field name="body" class="oe-bordered-editor" options="{'style-inline': true}" force_save="1"/>
                <group col="4">
                    <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1"
                           colspan="2"/>
                    <field name="template_id" options="{'no_create': True}"
                           context="{'default_model': 'crm.lead', 'default_body_html': body, 'default_subject': subject}"/>
                </group>
                <footer>
                    <button string="Send" name="action_chatter_send_mail" type="object"
                            class="btn-primary o_mail_send" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>